NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/awspectrum

# Auth (JWT) — REQUIRED: min 32 chars. In production generate with: openssl rand -base64 48
JWT_SECRET=replace-with-strong-secret-at-least-32-chars

# CORS — origen exacto del frontend (ej. https://tu-dominio.github.io o https://tu-app.com)
CORS_ORIGIN=http://localhost:5173

# AWS (SES) — opcional en dev; requerido en producción para envío real de correos
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_SOURCE_EMAIL=noreply@awspectrum.com

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Admin seed (solo se usa con `prisma:seed`)
ADMIN_SEED_EMAIL=admin@awspectrum.com
# IMPORTANTE: cambiar en producción — el seed no debe ejecutarse con la contraseña por defecto
ADMIN_SEED_PASSWORD=change-this-in-production
